# Copy this file to .env.local and paste your key from console.anthropic.com
# Never commit .env.local — it's already in .gitignore.
ANTHROPIC_API_KEY=

# Optional: raises openFDA's limit from 1,000 to 120,000 requests a day.
# Free key: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# Supabase (accounts + Codex). Both values are from your Supabase project's settings.
# The publishable key is designed to be public; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret used to scramble visitor IP addresses for the daily decode limit. Any long random string.
RATE_LIMIT_SALT=
# Optional: decodes allowed per visitor per day (default 25).
DAILY_DECODE_LIMIT=

# Google sign-in button. The "Client ID" of your Google Cloud OAuth client (public by design).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
